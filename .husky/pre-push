#!/usr/bin/env sh
set -eu

zero_sha="0000000000000000000000000000000000000000"
changed_files=""

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" != "$zero_sha" ]; then
    base="$remote_sha"
  else
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git merge-base "$local_sha" main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | head -n 1)
  fi

  if [ -n "$base" ] && [ "$base" != "$local_sha" ]; then
    files=$(git diff --name-only --diff-filter=ACMR "$base" "$local_sha")
    if [ -n "$files" ]; then
      changed_files=$(printf "%s\n%s\n" "$changed_files" "$files")
    fi
  fi
done

changed_files=$(printf "%s\n" "$changed_files" | sed '/^$/d' | sort -u)

if [ -z "$changed_files" ]; then
  exit 0
fi

eslint_files=$(printf "%s\n" "$changed_files" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)
if [ -n "$eslint_files" ]; then
  printf "%s\n" "$eslint_files" | xargs pnpm exec eslint
fi

prettier_files=$(printf "%s\n" "$changed_files" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|md|css|yml|yaml)$' || true)
if [ -n "$prettier_files" ]; then
  printf "%s\n" "$prettier_files" | xargs pnpm exec prettier --check --ignore-unknown
fi
