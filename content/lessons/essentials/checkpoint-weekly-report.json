{
  "id": "checkpoint-weekly-report",
  "module": "essentials",
  "title": "Checkpoint: a small weekly report",
  "goal": "Turn a raw week of orders into a tidy report using formulas, fill, Flash Fill, sorting, number formats, paste values and Freeze Panes, without step-by-step help.",
  "difficulty": 2,
  "requiredCorrect": 13,
