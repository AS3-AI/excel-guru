        ["Ticket", "Points", "Winner", "Find", "Winner"],
        ["T-14", 98, "Mina", 3, null],
        ["T-08", 94, "Dev", null, null],
        ["T-23", 91, "Isha", null, null],
        ["T-05", 87, "Noah", null, null],
        ["T-31", 82, "Leah", null, null]
      ],
      "targetCell": "E2",
      "expectedValue": "Isha",
      "mustUse": ["INDEX"],
      "solution": "=INDEX(C2:C6,3)",
      "explain": "Isha is the third name in C2:C6, even though she is on row 4 of the sheet.",
      "highlightCells": ["C2:C6"],
      "mobileButtons": ["=", "(", ")", ",", ":"]
