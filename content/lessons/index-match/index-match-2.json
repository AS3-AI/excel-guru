    {
      "id": "s1",
      "type": "info",
      "text": "**INDEX** returns the item at a position in a list or table. For one column, use `=INDEX(list, position)`; for a table, use `=INDEX(table, row, column)`."
    },
    {
      "id": "s2",
      "type": "select",
      "prompt": "A school ranks prize winners by points. Select the winner list, without the header: `C2:C6`.",
      "grid": [
        ["Ticket", "Points", "Winner", "Find", "Winner"],
        ["T-14", 98, "Mina", 3, null],
        ["T-08", 94, "Dev", null, null],
        ["T-23", 91, "Isha", null, null],
        ["T-05", 87, "Noah", null, null],
        ["T-31", 82, "Leah", null, null]
      ],
      "target": "C2:C6"
    },
    {
      "id": "s3",
      "type": "formula",
      "prompt": "Who is the 3rd prize winner in the ranked list? In `E2`, type `=INDEX(C2:C6,3)` and press Enter.",
