  "steps": [
    {
      "id": "s1",
      "type": "info",
      "text": "**IS** functions answer TRUE or FALSE about a cell: ISNUMBER uses `=ISNUMBER(value)`, ISTEXT uses `=ISTEXT(value)`, ISBLANK uses `=ISBLANK(value)`, and ISERROR, ISERR and ISNA use `=ISERROR(value)`, `=ISERR(value)` and `=ISNA(value)`. ISERROR catches every error; ISERR catches errors except #N/A, which ISNA checks specifically."
    },
    {
      "id": "s2",
      "type": "select",
      "prompt": "Select ticket 2’s entry in `B3`.",
      "grid": [
        [
          "Ticket",
          "Entry",
          "Is number?"
        ],
        [
          "1",
          42,
          null
        ],
        [
          "2",
          "n/a",
          null
        ],
        [
          "3",
          99,
          null
        ]
      ],
      "target": "B3"
    },
    {
      "id": "s3",
      "type": "formula",
      "prompt": "In `C3`, type `=ISNUMBER(B3)` and press Enter.",
      "grid": [
        [
          "Ticket",
          "Entry",
          "Is number?"
        ],
        [
          "1",
          42,
          null
        ],
        [
          "2",
