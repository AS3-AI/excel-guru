          null
        ],
        [
          "3",
          99,
          null
        ]
      ],
      "targetCell": "C3",
      "expectedValue": false,
      "mustUse": [
        "ISNUMBER"
      ],
      "solution": "=ISNUMBER(B3)",
      "explain": "The cell contains the text n/a, not a numeric value.",
