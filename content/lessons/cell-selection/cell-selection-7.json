    {
      "id": "s1",
      "type": "info",
      "text": "**Cell selection shortcuts** navigate and highlight data quickly without a mouse: `Ctrl+Arrow` jumps to the edge, `Ctrl+Shift+Arrow` extends to the edge, `Shift+Space` selects a row, `Ctrl+Space` selects a column, and `Ctrl+A` selects the whole table (on Mac, use `⌘` instead of Ctrl)."
    },
    {
      "id": "s2",
      "type": "select",
      "prompt": "A bakery tracks weekend sales. Click the first item: `A2`.",
      "grid": [
        ["Item", "Category", "Price", "Sold", "Total"],
        ["Sourdough", "Bread", 6, 15, 90],
        ["Croissant", "Pastry", 4, 24, 96],
        ["Muffin", "Pastry", 3, 18, 54],
        ["Bagel", "Bread", 2, 30, 60],
        ["Scone", "Pastry", 3, 12, 36],
        ["Focaccia", "Bread", 5, 10, 50]
