    {
      "id": "s8",
      "type": "mcq",
      "prompt": "You are in `B2` and press `Ctrl+↓` instead of `Ctrl+Shift+↓`. What happens?",
      "options": [
        "The active cell jumps to `B5` without selecting the cells in between",
        "The cells from `B2:B5` are all selected",
        "The selection extends down by only one cell to `B3`"
      ],
      "answer": 0
