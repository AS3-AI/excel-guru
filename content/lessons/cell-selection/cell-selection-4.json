  "steps": [
    {
      "id": "s1",
      "type": "info",
      "text": "**Row and column shortcuts** let you select or edit whole lines in one press: `Shift+Space` row · `Ctrl+Space` column · `Ctrl+Shift+=` insert · `Ctrl+-` delete. On Mac, use `⌘` for insert and delete (`⌘⇧=` and `⌘-`). macOS reserves `Ctrl+Space` for switching input sources, so column selection has no default Mac shortcut."
    },
    {
      "id": "s2",
      "type": "select",
      "prompt": "A café plans its weekly shifts. Click Ben's shift: `B3`.",
      "grid": [
        ["Day", "Shift", "Staff", "Hours"],
        ["Mon", "Morning", "Asha", 6],
        ["Tue", "Morning", "Ben", 6],
        ["Wed", "Evening", "Chaya", 5],
        ["Thu", "Evening", "Dev", 5],
        ["Fri", "Morning", "Elena", 6]
      ],
      "target": "B3"
    },
    {
      "id": "s3",
      "type": "shortcut",
      "mode": "chord",
      "prompt": "Select Ben's entire row: press `Shift+Space` (Mac: `⇧Space`).",
      "keys": {
        "win": "Shift+Space",
        "mac": "Shift+Space"
      },
      "activeCell": "B3",
      "grid": [
        ["Day", "Shift", "Staff", "Hours"],
        ["Mon", "Morning", "Asha", 6],
        ["Tue", "Morning", "Ben", 6],
        ["Wed", "Evening", "Chaya", 5],
        ["Thu", "Evening", "Dev", 5],
        ["Fri", "Morning", "Elena", 6]
