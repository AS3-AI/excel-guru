{
  "id": "cell-selection-3",
  "module": "cell-selection",
  "title": "Larger selections",
  "difficulty": 1,
  "requiredCorrect": 6,
  "isIntro": false,
  "video": null,
  "steps": [
    {
      "id": "s1",
      "type": "info",
      "text": "**Selection shortcuts** highlight large ranges in seconds: `Ctrl+A` selects the current data region (press twice for the whole sheet), `Ctrl+Shift+End` extends to the last used cell, and `Ctrl+Shift+Home` extends to cell `A1`. On a Mac use `⌘A` and `⌘⇧End` (on laptops: `fn+Ctrl+Shift+←` for Home)."
    },
    {
      "id": "s2",
      "type": "select",
      "prompt": "A farm stand tracks produce sales. Click a cell inside the table to start: `B2`.",
      "grid": [
        ["Item", "Category", "Bags", "Price", null],
        ["Apples", "Fruit", 14, 3, null],
        ["Carrots", "Root", 22, 2, null],
        ["Spinach", "Leafy", 18, 4, null],
        ["Berries", "Fruit", 9, 5, null],
        [null, null, null, null, null]
      ],
      "target": "B2"
    },
    {
      "id": "s3",
      "type": "shortcut",
      "mode": "chord",
      "prompt": "Select the entire produce table: press `Ctrl+A` (Mac: `⌘A`).",
      "keys": {
        "win": "Ctrl+A",
        "mac": "Cmd+A"
      },
      "activeCell": "B2",
      "grid": [
        ["Item", "Category", "Bags", "Price", null],
        ["Apples", "Fruit", 14, 3, null],
        ["Carrots", "Root", 22, 2, null],
        ["Spinach", "Leafy", 18, 4, null],
