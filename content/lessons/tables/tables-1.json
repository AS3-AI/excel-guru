        ["North", "Desk", 14, null, "North", null, null],
        ["South", "Chair", 17, null, "South", null, null],
        ["North", "Lamp", 8, null, null, null, null],
        ["South", "Desk", 15, null, null, null, null],
        ["North", "Desk", 12, null, null, null, null],
        ["North", "Chair", 16, null, null, null, null],
        ["South", "Chair", 22, null, null, null, null]
      ],
      "target": "C2:C8"
    },
    {
      "id": "s3",
      "type": "formula",
      "prompt": "In `F2`, total units for the North region using `=SUMIF(A2:A8,E2,C2:C8)`.",
