      "id": "s7",
      "type": "mcq",
      "prompt": "Why does `=SUMIFS(A2:A8,\"May\",B2:B8,\"Dev\",C2:C8)` return an error in Excel?",
      "options": [
        "The sum range `C2:C8` must be the first argument in SUMIFS.",
