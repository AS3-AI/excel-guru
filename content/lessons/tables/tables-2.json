  "steps": [
    {
      "id": "s1",
      "type": "info",
      "text": "In a pivot table, placing fields in both Rows and Columns creates a two-way summary called a **cross-tab**. Each inner cell calculates a total matching two conditions, just like SUMIFS."
    },
    {
      "id": "s2",
      "type": "select",
      "prompt": "A project tracker logs hours by month and team. Select the hours: `C2:C8`.",
      "grid": [
        ["Month", "Team", "Hours", null, "Sum", "May", "Jun"],
        ["May", "Dev", 10, null, "Dev", null, null],
        ["May", "Ops", 14, null, "Ops", null, null],
        ["Jun", "Ops", 15, null, null, null, null],
        ["May", "Dev", 12, null, null, null, null],
        ["May", "Ops", 11, null, null, null, null],
        ["Jun", "Dev", 18, null, null, null, null],
        ["Jun", "Dev", 16, null, null, null, null]
      ],
      "target": "C2:C8"
    },
    {
      "id": "s3",
      "type": "formula",
      "prompt": "In `F2`, find total May hours for the Dev team: `=SUMIFS(C2:C8,A2:A8,\"May\",B2:B8,\"Dev\")`.",
      "grid": [
        ["Month", "Team", "Hours", null, "Sum", "May", "Jun"],
        ["May", "Dev", 10, null, "Dev", null, null],
        ["May", "Ops", 14, null, "Ops", null, null],
        ["Jun", "Ops", 15, null, null, null, null],
        ["May", "Dev", 12, null, null, null, null],
        ["May", "Ops", 11, null, null, null, null],
        ["Jun", "Dev", 18, null, null, null, null],
        ["Jun", "Dev", 16, null, null, null, null]
      ],
      "targetCell": "F2",
      "expectedValue": 22,
      "mustUse": [
        "SUMIFS"
      ],
      "solution": "=SUMIFS(C2:C8,A2:A8,\"May\",B2:B8,\"Dev\")",
      "explain": "Row 2 (10) and row 5 (12) match both May and Dev, totaling 22 hours.",
      "highlightCells": [
        "C2:C8",
        "A2:A8",
        "B2:B8"
      ],
      "mobileButtons": [
        "=",
        "(",
        ")",
