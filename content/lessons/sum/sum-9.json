        [
          "D",
          10
        ],
        [
          "Total",
          "=SUM(B2:B4)"
        ]
      ],
      "target": "B2:B5"
    },
    {
      "id": "s3",
      "type": "formula",
      "prompt": "The formula in `B6` misses the last class: `=SUM(B2:B4)`. In `B6`, correct the formula to total all donations.",
