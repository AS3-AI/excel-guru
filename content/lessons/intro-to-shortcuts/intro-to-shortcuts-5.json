  "steps": [
    {
      "id": "s1",
      "type": "info",
      "text": "**Clipboard shortcuts** duplicate, move, and restore cell contents without using the mouse: `Ctrl+C` copy, `Ctrl+X` cut, and `Ctrl+V` paste. Press `Ctrl+Z` to undo a mistake and `Ctrl+Y` to redo it. On a Mac, use `⌘` instead of Ctrl (`⌘C`, `⌘X`, `⌘V`, `⌘Z`, `⌘Y`)."
    },
    {
      "id": "s2",
      "type": "select",
      "prompt": "A bakery tracks its morning inventory. Select the croissant price you'll copy: `C2`.",
      "grid": [
        ["Item", "Category", "Price", "Stock"],
        ["Croissant", "Pastry", 35, 12],
        ["Muffin", "Pastry", null, 15],
        ["Sourdough", "Bread", 45, 8],
        ["Baguette", "Bread", 40, 10],
        ["Roll", "Bread", null, 20],
        [null, "Pastry", 30, "Danish"]
      ],
      "target": "C2"
    },
    {
      "id": "s3",
      "type": "shortcut",
      "mode": "chord",
      "prompt": "Copy the price in `C2`: press `Ctrl+C` (Mac: `⌘C`).",
      "keys": {
        "win": "Ctrl+C",
        "mac": "Cmd+C"
      },
      "activeCell": "C2",
