  "steps": [
    {
      "id": "s1",
      "type": "info",
      "text": "**Formatting shortcuts** style the selected cell without the ribbon: `Ctrl+B` bold, `Ctrl+I` italic, `Ctrl+U` underline and `Ctrl+5` strikethrough. On a Mac use `⌘` instead of Ctrl (strikethrough is `⌘⇧X`). Press the same shortcut again to turn the style off."
    },
    {
      "id": "s2",
      "type": "select",
      "prompt": "A team keeps a task list. Select the heading you'll make bold: `A1`.",
      "grid": [
        [
          "Item",
          "Status",
          null,
          null
        ],
        [
          "Monthly report",
          "Done",
          null,
          null
        ],
        [
          "Team photos",
          "Pending",
          null,
          null
        ],
        [
          "Budget draft",
          "Pending",
          null,
          null
        ],
        [
          "Old banner",
          "Cancelled",
          null,
          null
        ],
        [
          "Total",
          "4 tasks",
          null,
          null
        ]
      ],
      "target": "A1"
    },
    {
      "id": "s3",
      "type": "shortcut",
      "mode": "chord",
      "prompt": "Make the heading in `A1` bold: press `Ctrl+B` (Mac: `⌘B`).",
      "keys": {
        "win": "Ctrl+B",
        "mac": "Cmd+B"
      },
      "activeCell": "A1",
      "grid": [
        [
          "Item",
