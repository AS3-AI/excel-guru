  "steps": [
    {
      "id": "s1",
      "type": "info",
      "text": "**Data shortcuts** help you manage records and enter data fast without reaching for the mouse: `Ctrl+Shift+L` toggles filter arrows (Mac: `⌘⇧F`), `Alt+↓` opens a column's filter menu (Mac: `⌥↓`), `Ctrl+;` inserts today's date, and `Ctrl+Shift+;` inserts the current time (Mac: `⌘;`). Press `F2` to edit the active cell directly."
    },
    {
      "id": "s2",
      "type": "select",
      "prompt": "A dispatch team tracks daily orders. Select the first table header: `A1`.",
      "grid": [
        ["Order", "Client", "Date", "Time", "Status"],
        [101, "Asha", "2026-11-14", "10:30", "Delivered"],
        [102, "Bikram", "2026-11-15", "14:15", "Shipped"],
        [103, "Chaya", "2026-11-15", "16:45", "Pending"],
        [104, "Dev", null, null, "New"],
        [105, "Esha", null, null, "New"]
      ],
      "target": "A1"
    },
    {
      "id": "s3",
      "type": "shortcut",
      "mode": "chord",
      "prompt": "Turn on filter arrows for the table: press `Ctrl+Shift+L` (Mac: `⌘⇧F`).",
      "keys": {
        "win": "Ctrl+Shift+L",
        "mac": "Shift+Cmd+F"
      },
      "activeCell": "A1",
      "grid": [
        ["Order", "Client", "Date", "Time", "Status"],
        [101, "Asha", "2026-11-14", "10:30", "Delivered"],
        [102, "Bikram", "2026-11-15", "14:15", "Shipped"],
